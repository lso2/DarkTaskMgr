<UserControl x:Class="DarkTaskMgr.UI.AppHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DarkTaskMgr.UI"
             Background="{DynamicResource BgBrush}">
    <Grid Margin="10,8,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Time-range chips span the top -->
        <DockPanel Grid.Row="0">
            <TextBlock x:Name="SinceLabel" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ChipToday" Style="{StaticResource Chip}" GroupName="hrange" Content="Today" IsChecked="True" Checked="Range_Checked" />
                <RadioButton x:Name="ChipWeek"  Style="{StaticResource Chip}" GroupName="hrange" Content="This week" Checked="Range_Checked" />
                <RadioButton x:Name="ChipMonth" Style="{StaticResource Chip}" GroupName="hrange" Content="This month" Checked="Range_Checked" />
                <RadioButton x:Name="ChipAll"   Style="{StaticResource Chip}" GroupName="hrange" Content="All time" Checked="Range_Checked" />
            </StackPanel>
        </DockPanel>

        <!-- Two resizable columns: cards on the left, the full table on the right -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CardsCol" Width="572" MinWidth="150" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Left: high-usage cards, wrapping to as many columns as the width allows -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource H2}" Text="High-usage applications" Margin="2,0,0,8" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ui:ScrollHelper.Smooth="True">
                    <WrapPanel x:Name="Cards" Orientation="Horizontal" />
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource StrokeBrush}" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <!-- Right: every application in the range -->
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="TableCaption" Style="{StaticResource Caption}" Margin="2,3,0,7" Text="ALL APPLICATIONS" />
                <ListView x:Name="List" Grid.Row="1" Style="{StaticResource ListDark}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn x:Name="AName" Width="200" Header="Name">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="6,0,7,0" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ACpu"  Width="110" Header="CPU time">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CpuTimeText}" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="APeak" Width="200" Header="Peak CPU">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PeakText}" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="AEvents" Width="80" Header="Spikes">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EventsText}" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
