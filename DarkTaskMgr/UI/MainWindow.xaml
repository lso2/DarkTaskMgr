<Window x:Class="DarkTaskMgr.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DarkTaskMgr" Height="720" Width="1000" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BgBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="12,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/DarkTaskMgr;component/darktaskmgr.ico" Width="17" Height="17" Margin="2,0,9,0" />
                        <TextBlock Text="DarkTaskMgr" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <Border x:Name="AdminBadge" Margin="10,0,0,0" Padding="7,2" CornerRadius="5" Background="{DynamicResource PanelAltBrush}" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Administrator" FontSize="10.5" Foreground="{DynamicResource WarnBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinBtn" Style="{StaticResource TitleBarButton}" Click="Min_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE921;" />
                        </Button>
                        <Button x:Name="MaxBtn" Style="{StaticResource TitleBarButton}" Click="Max_Click">
                            <TextBlock x:Name="MaxGlyph" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE922;" />
                        </Button>
                        <Button x:Name="CloseBtn" Style="{StaticResource CloseButton}" Click="Close_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Menu bar -->
            <Border Grid.Row="1" Background="{DynamicResource TitleBarBrush}">
                <StackPanel Orientation="Horizontal" Margin="8,0,0,4">
                    <Button x:Name="FileMenuBtn" Style="{StaticResource MenuBarButton}" Content="File" Click="FileMenu_Click" />
                    <Button x:Name="OptionsMenuBtn" Style="{StaticResource MenuBarButton}" Content="Options" Click="OptionsMenu_Click" />
                    <Button x:Name="ViewMenuBtn" Style="{StaticResource MenuBarButton}" Content="View" Click="ViewMenu_Click" />
                </StackPanel>
            </Border>

            <!-- Tab strip -->
            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}" Padding="8,2,8,8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabProcesses"   Style="{StaticResource NavTab}" GroupName="tabs" Content="Processes"   IsChecked="True" Checked="Tab_Changed" />
                    <RadioButton x:Name="TabPerformance" Style="{StaticResource NavTab}" GroupName="tabs" Content="Performance" Checked="Tab_Changed" />
                    <RadioButton x:Name="TabAppHistory"  Style="{StaticResource NavTab}" GroupName="tabs" Content="App history" Checked="Tab_Changed" />
                    <RadioButton x:Name="TabStartup"     Style="{StaticResource NavTab}" GroupName="tabs" Content="Startup"     Checked="Tab_Changed" />
                    <RadioButton x:Name="TabUsers"       Style="{StaticResource NavTab}" GroupName="tabs" Content="Users"       Checked="Tab_Changed" />
                    <RadioButton x:Name="TabDetails"     Style="{StaticResource NavTab}" GroupName="tabs" Content="Details"     Checked="Tab_Changed" />
                    <RadioButton x:Name="TabServices"    Style="{StaticResource NavTab}" GroupName="tabs" Content="Services"    Checked="Tab_Changed" />
                </StackPanel>
            </Border>

            <!-- Content host: all tab views live here, only the active one is visible -->
            <Grid x:Name="Host" Grid.Row="3" Margin="0" />

            <!-- Status bar -->
            <Border Grid.Row="4" Background="{DynamicResource TitleBarBrush}" CornerRadius="0,0,10,10" Padding="14,6">
                <Grid>
                    <TextBlock x:Name="StatusLeft" Style="{StaticResource Caption}" Text="" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusRight" Style="{StaticResource Caption}" Text="" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
