<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette. Styles live in Controls.xaml and reference these by DynamicResource, so the
         load order between the two dictionaries does not matter. Tuned to read like the Windows
         Task Manager, which has no first-party dark theme on Windows 10. -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DarkTaskMgr;component/Themes/Controls.xaml" />
        <ResourceDictionary Source="/DarkTaskMgr;component/Themes/Lists.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="BgBrush"            Color="#FF191B1F" />
    <SolidColorBrush x:Key="TitleBarBrush"      Color="#FF202227" />
    <SolidColorBrush x:Key="PanelBrush"         Color="#FF1E2024" />
    <SolidColorBrush x:Key="PanelAltBrush"      Color="#FF26282E" />
    <SolidColorBrush x:Key="HeaderBrush"        Color="#FF202227" />
    <SolidColorBrush x:Key="StrokeBrush"        Color="#FF303339" />
    <SolidColorBrush x:Key="StrokeSoftBrush"    Color="#FF26282D" />

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FFE8EAED" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9AA0AA" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#FF6B7078" />

    <SolidColorBrush x:Key="AccentBrush"        Color="#FF4CA0FF" />
    <SolidColorBrush x:Key="SelectionBrush"     Color="#FF294A6E" />
    <SolidColorBrush x:Key="SelectionInactive"  Color="#FF2C2F36" />

    <SolidColorBrush x:Key="OkBrush"            Color="#FF3FB96D" />
    <SolidColorBrush x:Key="WarnBrush"          Color="#FFE8B03F" />
    <SolidColorBrush x:Key="DangerBrush"        Color="#FFE05A5A" />

    <!-- Performance-graph line colors -->
    <SolidColorBrush x:Key="CpuBrush"           Color="#FF4CA0FF" />
    <SolidColorBrush x:Key="MemBrush"           Color="#FFB06CF0" />
    <SolidColorBrush x:Key="DiskBrush"          Color="#FF56B36A" />
    <SolidColorBrush x:Key="NetBrush"           Color="#FF39C0C8" />
    <SolidColorBrush x:Key="GpuBrush"           Color="#FFE0A93C" />

    <SolidColorBrush x:Key="HoverOverlay"       Color="#18FFFFFF" />
    <SolidColorBrush x:Key="PressOverlay"       Color="#28FFFFFF" />

</ResourceDictionary>
